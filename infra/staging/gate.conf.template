# The door in front of Diddit staging (ST-1357). The nginx image fills in
# ${GATE_COOKIE} at start; nginx's own $variables are left alone.
#
# Why a cookie as well as basic auth: the app sends its login token as
# `Authorization: Bearer ...`, which is the same header basic auth uses. So the API
# cannot sit behind basic auth. Pages and files need basic auth, and that answer
# sets an HttpOnly cookie; /api/ needs the cookie. A stranger without the password
# gets neither.

server {
  listen 80;
  server_name _;
  absolute_redirect off;

  # Staging must never be indexed, whatever answers.
  add_header X-Robots-Tag "noindex, nofollow" always;

  # The frontend's own Cache-Control would let Cloudflare keep a copy and hand it
  # out without the password. Nothing behind this gate is shared.
  proxy_hide_header Cache-Control;
  add_header Cache-Control "private, no-store" always;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /robots.txt {
    default_type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
  }

  # Open, so the deploy and the host can check staging is up. It says only "ok".
  location = /health {
    proxy_pass http://frontend:80;
  }

  location /api/ {
    if ($cookie_st44_staging_gate != "${GATE_COOKIE}") {
      return 401;
    }
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_pass http://frontend:80;
  }

  location / {
    auth_basic "Diddit staging";
    auth_basic_user_file /etc/nginx/htpasswd;
    # Basic auth is done here; the app never needs to see it.
    proxy_set_header Authorization "";
    add_header Set-Cookie "st44_staging_gate=${GATE_COOKIE}; Path=/; Secure; HttpOnly; SameSite=Lax" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "private, no-store" always;
    proxy_pass http://frontend:80;
  }
}
