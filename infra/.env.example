DB_PASSWORD=your-secure-password-here
CORS_ORIGIN=*

# Login token signing secret. Required; the backend will not start without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Web push (optional). Without both keys the backend runs with push off.
# Generate a pair with: npx web-push generate-vapid-keys
# In production these come from the VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY GitHub secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# Required for Google Sign-In functionality
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com

# Email Configuration (SendGrid)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@diddit.com
APP_URL=http://localhost:4200
