# -----------------------------------------------------------
#  Build Stage
# -----------------------------------------------------------
FROM node:24-alpine AS build
WORKDIR /app

# Build argument for Google OAuth Client ID
ARG GOOGLE_CLIENT_ID=""

# Copy workspace root package files
COPY package*.json ./

# Copy shared types package
COPY packages/types ./packages/types

# Copy frontend package files
COPY apps/frontend/package*.json ./apps/frontend/

# Install dependencies from the lock file so the image matches the commit.
#
# This used to be `rm -f package-lock.json && npm install` (8db4f0d) to work around
# the build failing on a missing lightningcss.linux-x64-musl.node. The actual cause
# of that was fixed six minutes earlier in 7a92ee5: `COPY apps/frontend` was copying
# the host's Windows node_modules over the installed Linux ones. We now copy only
# source files, so the lock file no longer needs bypassing -- and the lock file does
# contain lightningcss-linux-x64-musl, so Alpine resolves the right binary.
RUN npm ci

# Build shared types package
RUN npm run build --workspace=packages/types

# Copy frontend source files only -- never the host's node_modules, which would
# overwrite the Linux binaries installed above with host-platform ones (7a92ee5).
COPY apps/frontend/src ./apps/frontend/src
COPY apps/frontend/public ./apps/frontend/public
COPY apps/frontend/angular.json ./apps/frontend/angular.json
COPY apps/frontend/tsconfig*.json ./apps/frontend/
COPY apps/frontend/.postcssrc.json ./apps/frontend/.postcssrc.json
COPY apps/frontend/eslint.config.js ./apps/frontend/eslint.config.js

# Inject build timestamp and Google Client ID into environment.ts
RUN BUILD_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ") && \
    sed -i "s/BUILD_TIME_PLACEHOLDER/$BUILD_TIME/g" apps/frontend/src/environments/environment.ts && \
    sed -i "s/GOOGLE_CLIENT_ID_PLACEHOLDER/$GOOGLE_CLIENT_ID/g" apps/frontend/src/environments/environment.ts

# Build frontend
RUN npm run build --workspace=apps/frontend --omit=dev

# -----------------------------------------------------------
#  Runtime Stage (Nginx)
# -----------------------------------------------------------
FROM nginx:stable-alpine
WORKDIR /usr/share/nginx/html

# Remove default nginx content
RUN rm -rf ./*

# Copy built Angular app (Norwegian locale) - maintain /no/ path for i18n
COPY --from=build /app/apps/frontend/dist/home/browser/no ./no

# Provide custom nginx config
COPY infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
